CONFIGURE_SUBST_FILES += ['installer/Makefile']

if not CONFIG['MOZ_PALEMOON_DESKTOP_CHROME']:
    # The Fennec locale jars register chrome 'browser' locale entries,
    # which collide with the palemoon/locales jars.
    DIRS += [
        '../locales',
        'locales',
    ]

if CONFIG['MOZ_ANDROID_MLS_STUMBLER']:
    DIRS += ['stumbler']

DIRS += [
    'javaaddons', # Must be built before base.
    'base',
]

if not CONFIG['MOZ_PALEMOON_DESKTOP_CHROME']:
    # 'chrome' and 'themes/core' produce jars that register the 'browser'
    # content/skin chrome packages; the palemoon/ subtree registers its
    # own jars for the same names when MOZ_PALEMOON_DESKTOP_CHROME is on.
    DIRS += [
        'chrome',
        'themes/core',
    ]

DIRS += [
    'components',
    'extensions',
    'modules',
    'app',
    'fonts',
]

if CONFIG['MOZ_ANDROID_PACKAGE_INSTALL_BOUNCER']:
    DIRS += ['bouncer'] # No ordering implied with respect to base.

TEST_DIRS += [
    'tests',
]

SPHINX_TREES['fennec'] = 'docs'
