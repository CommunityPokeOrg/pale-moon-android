if not CONFIG['MOZ_PALEMOON_DESKTOP_CHROME']:
    # palemoon/components/sessionstore ships its own nsISessionStore
    # with a different IID; only one may exist in the linked xpt.
    # SessionStore.idl is this module's only source, so in palemoon
    # mode the whole MobileComponents xpt is skipped.
    XPIDL_SOURCES += [
        'SessionStore.idl',
    ]

    XPIDL_MODULE = 'MobileComponents'

EXTRA_COMPONENTS += [
    'AddonUpdateService.js',
    'BlocklistPrompt.js',
    'ColorPicker.js',
    'ContentDispatchChooser.js',
    'FilePicker.js',
    'HelperAppDialog.js',
    'ImageBlockingPolicy.js',
    'LoginManagerPrompter.js',
    'NSSDialogService.js',
    'PersistentNotificationHandler.js',
    'PresentationDevicePrompt.js',
    'PresentationRequestUIGlue.js',
    'PromptService.js',
    'SiteSpecificUserAgent.js',
    'Snippets.js',
    'TabSource.js',
    'XPIDialogService.js',
]

if not CONFIG['MOZ_PALEMOON_DESKTOP_CHROME']:
    # These register contracts that the palemoon/ desktop components
    # also provide (about: redirector, browser CLH, directory provider,
    # content-permission prompt, session store). When the desktop chrome
    # is packaged, its versions win and these are left out so they don't
    # shadow them.
    EXTRA_COMPONENTS += [
        'AboutRedirector.js',
        'BrowserCLH.js',
        'ContentPermissionPrompt.js',
        'DirectoryProvider.js',
        'SessionStore.js',
    ]

# Keep it this way if at all possible.  If you need preprocessing,
# consider adding fields to AppConstants.jsm.
EXTRA_PP_COMPONENTS += [
    'MobileComponents.manifest',
]

DIRS += [
    'extensions',
    'build',
]
