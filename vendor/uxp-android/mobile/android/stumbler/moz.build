include('stumbler_sources.mozbuild')

stumbler_jar = add_java_jar('stumbler')
stumbler_jar.sources += stumbler_sources
stumbler_jar.extra_jars += CONFIG['ANDROIDX_EXTRA_JARS'].split() if CONFIG['ANDROIDX_EXTRA_JARS'] else []
stumbler_jar.javac_flags += ['-Xlint:all', '-Xlint:-deprecation']
